+            <LemonButton
+                icon={<IconInfo />}
+                size="xsmall"
+                type="tertiary"
+                aria-label="Show what each sending tier allows"
+                aria-expanded={visible}
+                onMouseEnter={() => setVisible(true)}
+                onMouseLeave={() => setVisible(false)}
+                onClick={() => setVisible(true)}
+                onKeyDown={(event) => {
+                    if (event.key === 'Escape') {
+                        setVisible(false)
+                    }
+                }}
+                data-attr="workflows-sending-tier-info"
+            />
+        </Popover>
+    )
