+# Workflows-only bans on top of products/ruff.toml. The invariants they enforce live in
+# Backend.spec.md next to this file.
+extend = "../../ruff.toml"
+
+[lint]
+extend-select = ["TID251"]
+
+[lint.flake8-tidy-imports.banned-api]
+"posthog.hogql.compiler.bytecode.create_bytecode".msg = "server-compiles-all-bytecode (products/workflows/backend/Backend.spec.md): compile bytecode only in HogFlowSerializer in presentation/views/hog_flow.py"
+"posthog.cdp.filters.compile_filters_expr".msg = "server-compiles-all-bytecode (products/workflows/backend/Backend.spec.md): compile bytecode only in HogFlowSerializer in presentation/views/hog_flow.py"
+"posthog.cdp.validation.generate_template_bytecode".msg = "server-compiles-all-bytecode (products/workflows/backend/Backend.spec.md): compile bytecode only in HogFlowSerializer in presentation/views/hog_flow.py"
+"boto3".msg = "ses-only-through-provider (products/workflows/backend/Backend.spec.md): call SESProvider from providers/ses.py"
+"botocore".msg = "ses-only-through-provider (products/workflows/backend/Backend.spec.md): call SESProvider from providers/ses.py"
+
+# extend-, not per-file-ignores: the plain table would replace products/ruff.toml's ignores.
+[lint.extend-per-file-ignores]
+# The paved paths: the serializer compiles bytecode, the provider wraps SES.
+"presentation/views/hog_flow.py" = ["TID251"]
+"providers/ses.py" = ["TID251"]
+"**/test/**" = ["TID251"]
+"**/tests/**" = ["TID251"]
+"**/test_*" = ["TID251"]
