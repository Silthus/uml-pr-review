+from dataclasses import dataclass
+
+from products.feature_flags.backend.facade.api import FlagSummary, get_flag_summaries_by_key
+
+
+@dataclass(frozen=True)
+class IssueFlagInfo:
+    id: int
+    key: str
+    name: str
+    active: bool
+    deleted: bool
+
+
+def resolve_issue_flags(team_id: int, keys: list[str]) -> dict[str, IssueFlagInfo]:
+    return {summary.key: issue_flag_info(summary) for summary in get_flag_summaries_by_key(team_id, keys)}
+
+
+def issue_flag_info(summary: FlagSummary) -> IssueFlagInfo:
+    return IssueFlagInfo(id=summary.id, key=summary.key, name=summary.name, active=summary.active, deleted=summary.deleted)
