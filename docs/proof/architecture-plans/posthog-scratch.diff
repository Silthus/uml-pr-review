+import { useValues } from 'kea'
+
+import { urls } from 'scenes/urls'
+
+import { ErrorTrackingIssueFeatureFlag } from '~/queries/schema/schema-general'
+
+import { issueFilterPreviewLogic } from '../IssueFilterPreview/issueFilterPreviewLogic'
+
+export function IssueFeatureFlagsPreview({ flags }: { flags: ErrorTrackingIssueFeatureFlag[] }): JSX.Element {
+    const { preview } = useValues(issueFilterPreviewLogic)
+    return (
+        <ul data-preview={preview}>
+            {flags.map((flag) => (
+                <li key={`${flag.key}:${flag.variant}`}>
+                    {flag.flag_id ? <a href={urls.featureFlag(flag.flag_id)}>{flag.key}</a> : flag.key}
+                    {flag.variant ? ` = ${flag.variant}` : null} · {flag.occurrences}
+                </li>
+            ))}
+        </ul>
+    )
+}
