+function getGripStyle(mode: GripMode, hoveredCell: HoveredCell): CSSProperties {
+    const tableRect = hoveredCell.table.getBoundingClientRect()
+    if (mode === 'row') {
+        const rowRect = hoveredCell.row.getBoundingClientRect()
+        return {
+            top: rowRect.top,
+            left: tableRect.left - GRIP_SIZE - GRIP_OFFSET,
+            width: GRIP_SIZE + GRIP_OFFSET,
+            height: rowRect.height,
+        }
+    }
