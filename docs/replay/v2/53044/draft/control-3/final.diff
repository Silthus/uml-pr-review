+}
+
+type MenuAction = {
+    label: string
+    icon: JSX.Element
+    onClick: () => void
+    status?: 'danger'
+}
+
+function GripHandle({
+    mode,
+    hoveredCell,
+    isMenuOpen,
+    actions,
+    onCloseMenu,
+    onClick,
+}: {
+    mode: GripMode
+    hoveredCell: HoveredCell
+    isMenuOpen: boolean
+    actions: MenuAction[]
+    onCloseMenu: () => void
+    onClick: () => void
+}): JSX.Element {
+    const wrapperRef = useRef<HTMLDivElement>(null)
+
+    // Positioned imperatively because the grip has to track the table through scrolling and resizing
+    useLayoutEffect(() => {
+        const wrapper = wrapperRef.current
+        if (!wrapper) {
+            return
+        }
+        const { cell, row, table } = hoveredCell
+
+        const updatePosition = (): void => {
+            const tableRect = table.getBoundingClientRect()
+            if (mode === 'row') {
+                const rowRect = row.getBoundingClientRect()
+                wrapper.style.top = `${rowRect.top}px`
+                wrapper.style.left = `${tableRect.left - GRIP_SIZE - GRIP_OFFSET}px`
+                wrapper.style.width = `${GRIP_SIZE + GRIP_OFFSET}px`
+                wrapper.style.height = `${rowRect.height}px`
+            } else {
+                const cellRect = cell.getBoundingClientRect()
+                wrapper.style.top = `${tableRect.top - GRIP_SIZE - GRIP_OFFSET}px`
+                wrapper.style.left = `${cellRect.left}px`
+                wrapper.style.width = `${cellRect.width}px`
+                wrapper.style.height = `${GRIP_SIZE + GRIP_OFFSET}px`
+            }
+        }
+
+        updatePosition()
+        const resizeObserver = new ResizeObserver(updatePosition)
+        resizeObserver.observe(table)
+        resizeObserver.observe(row)
+        resizeObserver.observe(cell)
+        window.addEventListener('scroll', updatePosition, true)
+        window.addEventListener('resize', updatePosition)
+        return () => {
+            resizeObserver.disconnect()
+            window.removeEventListener('scroll', updatePosition, true)
+            window.removeEventListener('resize', updatePosition)
+        }
+    }, [mode, hoveredCell])
+
+    return (
+        // Wrapper extends from the icon to the table edge, bridging the hover gap
+        <div ref={wrapperRef} className="fixed flex items-center justify-center z-0" data-table-grip>
+            <Popover
+                visible={isMenuOpen}
+                onClickOutside={onCloseMenu}
+                placement={mode === 'row' ? 'right-start' : 'bottom-start'}
+                className={mode === 'row' ? 'ml-1' : 'mt-1'}
+                overlay={
+                    <div className="flex flex-col p-1 min-w-40">
+                        {actions.map((action, i) => (
+                            <div key={action.label}>
+                                {i > 0 && action.status === 'danger' && actions[i - 1]?.status !== 'danger' && (
+                                    <LemonDivider className="my-1" />
+                                )}
+                                <LemonButton
+                                    onClick={action.onClick}
+                                    icon={action.icon}
+                                    status={action.status}
+                                    size="small"
+                                    fullWidth
+                                >
+                                    {action.label}
+                                </LemonButton>
+                            </div>
+                        ))}
+                    </div>
+                }
+            >
+                <button
+                    className="flex items-center justify-center w-5 h-5 cursor-pointer border-0 rounded bg-transparent p-0 hover:bg-surface-secondary active:bg-surface-secondary"
+                    // Keep editor focus so the cell selection stays visible
+                    onMouseDown={(e) => e.preventDefault()}
+                    onClick={(e) => {
+                        e.preventDefault()
+                        e.stopPropagation()
+                        onClick()
+                    }}
+                    type="button"
+                    aria-label={mode === 'row' ? 'Row actions' : 'Column actions'}
+                >
+                    <IconDrag className={`text-tertiary text-lg${mode === 'col' ? ' rotate-90' : ''}`} />
+                </button>
+            </Popover>
+        </div>
+    )
+}
 
