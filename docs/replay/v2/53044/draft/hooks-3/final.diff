+                    size="xsmall"
+                    noPadding
+                    icon={<IconDrag className={`text-tertiary text-lg${mode === 'col' ? ' rotate-90' : ''}`} />}
+                    // Keep the editor selection intact when clicking the grip
+                    onMouseDown={(e) => e.preventDefault()}
+                    onClick={(e) => {
