+import { cn } from 'lib/utils/css-classes'
+
+type HandleKind = 'row' | 'column'
+
+type HoveredCell = {
+    cell: HTMLTableCellElement
+    table: HTMLTableElement
+}
+
+// Width of the invisible wrapper around each handle. It spans the whole gap between the handle and the
+// table, so moving the pointer from a cell to its handle never leaves a hover target and the handles don't flicker.
+const HANDLE_WRAPPER_SIZE = 28
+const HANDLE_WRAPPER_CLASS = 'NotebookTableMenu__handle'
+
+function findHoveredCell(target: EventTarget | null, root: HTMLElement): HoveredCell | 'table' | null {
+    if (!(target instanceof Element) || !root.contains(target)) {
+        return null
+    }
+    // Tables rendered by notebook nodes (e.g. LemonTable) are not editable tables
+    if (target.closest('.NotebookNode')) {
+        return null
+    }
+    const table = target.closest('table')
+    if (!table) {
+        return null
+    }
+    const cell = target.closest<HTMLTableCellElement>('td, th')
+    // Borders and padding between cells have no cell target, keep the current handles there
+    return cell ? { cell, table } : 'table'
+}
+
+function isHandleWrapper(target: EventTarget | null): boolean {
+    return target instanceof Element && !!target.closest(`.${HANDLE_WRAPPER_CLASS}`)
+}
+
+function runOnCell(
+    editor: TTEditor,
+    cell: HTMLTableCellElement,
+    command: (chain: ChainedCommands) => ChainedCommands
+): void {
+    const $pos = editor.state.doc.resolve(editor.view.posAtDOM(cell, 0))
+    for (let depth = $pos.depth; depth > 0; depth--) {
+        const tableRole = $pos.node(depth).type.spec.tableRole
+        if (tableRole === 'cell' || tableRole === 'header_cell') {
+            // Commands act on the selection, so select the hovered cell rather than wherever the cursor happens to be
+            command(editor.chain().focus().setCellSelection({ anchorCell: $pos.before(depth) })).run()
+            return
+        }
+    }
+}
 
