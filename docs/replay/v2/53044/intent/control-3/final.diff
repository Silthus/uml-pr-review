+// Width of the invisible strip between the handle and the table, so moving the cursor
+// from a cell to its handle never passes over "nothing" and makes the handle flicker
+const HANDLE_GUTTER = 24
+
+type MenuKind = 'row' | 'column'
+type TableCommand = (chain: EditorCommands) => EditorCommands
+
+function findEditableCell(target: EventTarget | null, editorDom: HTMLElement): HTMLTableCellElement | null {
+    if (!(target instanceof Element)) {
+        return null
+    }
+    const cell = target.closest('td, th')
+    // Tables rendered inside notebook nodes (e.g. LemonTable) are not part of the document
+    if (!(cell instanceof HTMLTableCellElement) || !editorDom.contains(cell) || cell.closest('.NotebookNode')) {
+        return null
+    }
+    return cell
+}
+
+function runInCell(editor: TTEditor, cell: HTMLTableCellElement, command: TableCommand): void {
+    // Table commands act on the selected cell, so move the cursor into the hovered one first
+    const pos = editor.view.posAtDOM(cell, 0)
+    command(editor.chain().focus().setTextSelection(pos)).run()
+}
 
