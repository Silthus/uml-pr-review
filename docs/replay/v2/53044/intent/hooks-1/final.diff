+
+type TableHandle = 'row' | 'column'
+
+const HANDLE_SIZE = 20
+
+// Tables rendered inside custom notebook nodes (e.g. LemonTable) aren't editable tiptap tables
+const findEditableCell = (target: EventTarget | null, editorDom: HTMLElement): HTMLTableCellElement | null => {
+    if (!(target instanceof Element) || !editorDom.contains(target)) {
+        return null
+    }
+    const cell = target.closest<HTMLTableCellElement>('td, th')
+    if (!cell || cell.closest('.NotebookNode')) {
+        return null
+    }
+    return cell
+}
 
 export function TableMenu(): JSX.Element | null {
     const { ttEditor } = useValues(richContentEditorLogic)
+    const [hoveredCell, setHoveredCell] = useState<HTMLTableCellElement | null>(null)
+    const [openHandle, setOpenHandle] = useState<TableHandle | null>(null)
+    // Handles are fixed-positioned from DOM rects, so re-measure whenever anything scrolls
+    const [, rerender] = useReducer((x: number) => x + 1, 0)
+    const handlesRef = useRef<HTMLDivElement>(null)
+
+    useEffect(() => {
+        if (!ttEditor) {
+            return
+        }
+
+        const onMouseMove = (e: MouseEvent): void => {
+            // While a menu is open keep the handles pinned to the cell it was opened for
+            if (openHandle || handlesRef.current?.contains(e.target as Node)) {
+                return
+            }
+            setHoveredCell(ttEditor.isEditable ? findEditableCell(e.target, ttEditor.view.dom) : null)
+        }
+
+        document.addEventListener('mousemove', onMouseMove)
+        window.addEventListener('scroll', rerender, true)
+        window.addEventListener('resize', rerender)
+        return () => {
+            document.removeEventListener('mousemove', onMouseMove)
+            window.removeEventListener('scroll', rerender, true)
+            window.removeEventListener('resize', rerender)
+        }
+    }, [ttEditor, openHandle])
 
