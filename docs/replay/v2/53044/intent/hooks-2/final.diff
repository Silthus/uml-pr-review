+import { TTEditor } from 'lib/components/RichContentEditor/types'
+import { IconDragHandle } from 'lib/lemon-ui/icons'
+
+// Width of the invisible wrapper between a handle and the table - the handle sits inside it,
+// so moving the mouse from a cell to its handle never leaves a hover target
+const HANDLE_GUTTER = 20
+
+type TableMenuKind = 'row' | 'column'
+
+const HANDLE_WRAPPER_CLASS = 'NotebookTableMenu__handle'
+
+function isInsideHandle(target: EventTarget | null): boolean {
+    return target instanceof Element && !!target.closest(`.${HANDLE_WRAPPER_CLASS}`)
+}
+
+function runOnCell(editor: TTEditor, cell: HTMLElement, command: (chain: ReturnType<TTEditor['chain']>) => void): void {
+    // The table commands act on the cell containing the selection, so move it into the hovered cell first
+    const pos = editor.view.posAtDOM(cell, 0)
+    const chain = editor
+        .chain()
+        .focus()
+        .command(({ tr }) => {
+            tr.setSelection(TextSelection.near(tr.doc.resolve(pos)))
+            return true
+        })
+    command(chain)
+    chain.run()
+}
 
