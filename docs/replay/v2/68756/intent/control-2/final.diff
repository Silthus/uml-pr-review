+    def _log_ai_gateway_credit_activity(self, request, team: Team, result: CreditResult, reason: str) -> None:
+        # The gateway ledger write can't share a transaction with ours, so key on the
+        # ledger entry id: an idempotent replay backfills a record the first submit
+        # failed to write, and never duplicates one that exists.
+        if self._ai_gateway_credit_logs(team).filter(item_id=result.entry_id).exists():
+            return
+        log_activity(
+            organization_id=team.organization_id,
+            team_id=team.id,
+            user=request.user,
+            was_impersonated=is_impersonated_session(request),
+            item_id=result.entry_id,
+            scope="AIGatewayCredit",
+            activity="credit_added",
+            detail=Detail(
+                name=f"Added ${result.amount_usd} AI gateway credit",
+                context=AIGatewayCreditActivityContext(
+                    amount_usd=result.amount_usd,
+                    reason=reason,
+                    balance_usd=result.balance_usd,
+                ),
+            ),
+        )
+
+    @admin.display(description="Recent top-ups")
+    def ai_gateway_credit_history(self, team: Team):
+        if not team.pk:
+            return "-"
+        logs = self._ai_gateway_credit_logs(team).select_related("user").order_by("-created_at")[:10]
+        top_ups = []
+        for log in logs:
+            context = (log.detail or {}).get("context") or {}
+            top_ups.append(
+                {
+                    "created_at": log.created_at,
+                    "user_email": log.user.email if log.user else None,
+                    "was_impersonated": log.was_impersonated,
+                    "amount_usd": context.get("amount_usd"),
+                    "reason": context.get("reason"),
+                }
+            )
+        # nosemgrep: python.django.security.audit.avoid-mark-safe.avoid-mark-safe (admin-only, renders trusted template)
+        return mark_safe(render_to_string("admin/posthog/team/ai_gateway_credit_history.html", {"top_ups": top_ups}))
+
