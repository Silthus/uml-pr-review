+    def _log_ai_gateway_credit(self, request, team: Team, result: CreditResult, amount: Decimal, reason: str) -> None:
+        # The ledger lives in the gateway, so this row can't share its transaction. Write it
+        # whenever it's missing, so an idempotent replay backfills a top-up whose audit write failed.
+        already_logged = ActivityLog.objects.filter(
+            team_id=team.id,
+            scope=AI_GATEWAY_CREDIT_SCOPE,
+            activity=AI_GATEWAY_CREDIT_ACTIVITY,
+            item_id=result.entry_id,
+        ).exists()
+        if already_logged:
+            return
+        amount_usd = result.amount_usd or str(amount)
+        log_activity(
+            organization_id=team.organization_id,
+            team_id=team.id,
+            user=request.user,
+            was_impersonated=is_impersonated_session(request),
+            item_id=result.entry_id,
+            scope=AI_GATEWAY_CREDIT_SCOPE,
+            activity=AI_GATEWAY_CREDIT_ACTIVITY,
+            detail=Detail(
+                name=f"AI gateway credit ${amount_usd}",
+                type="admin_add_ai_gateway_credit",
+                context=AIGatewayCreditActivityContext(
+                    amount_usd=amount_usd,
+                    reason=reason,
+                    balance_usd=result.balance_usd,
+                ),
+            ),
+        )
+
+    @admin.display(description="Recent top-ups")
+    def ai_gateway_credit_history(self, team: Team):
+        if not team.pk:
+            return "-"
+        entries = (
+            ActivityLog.objects.filter(team_id=team.pk, scope=AI_GATEWAY_CREDIT_SCOPE, activity=AI_GATEWAY_CREDIT_ACTIVITY)
+            .select_related("user")
+            .order_by("-created_at")[:AI_GATEWAY_CREDIT_HISTORY_LIMIT]
+        )
+        rows = []
+        for entry in entries:
+            context = (entry.detail or {}).get("context") or {}
+            who = entry.user.email if entry.user else "(deleted user)"
+            if entry.was_impersonated:
+                who = f"{who} (impersonated)"
+            rows.append((entry.created_at.isoformat(), who, context.get("amount_usd", ""), context.get("reason", "")))
+        if not rows:
+            return format_html("<em>No top-ups recorded</em>")
+        return format_html(
+            "<table><thead><tr><th>When</th><th>Who</th><th>Amount (USD)</th><th>Reason</th></tr></thead>"
+            "<tbody>{}</tbody></table>",
+            format_html_join("", "<tr><td>{}</td><td>{}</td><td>${}</td><td>{}</td></tr>", rows),
+        )
+
