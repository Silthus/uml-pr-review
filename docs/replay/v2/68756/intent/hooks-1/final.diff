+    def _record_ai_gateway_credit(self, request, team: Team, result: CreditResult, amount: Decimal, reason: str) -> None:
+        # The credit commits in the gateway, so it can't share a transaction with this row.
+        # Keying on the ledger entry lets a duplicate replay backfill a record the original
+        # request failed to write, without logging the same top-up twice.
+        already_recorded = ActivityLog.objects.filter(
+            team_id=team.id,
+            scope=AI_GATEWAY_CREDIT_SCOPE,
+            activity=AI_GATEWAY_CREDIT_ACTIVITY,
+            item_id=result.entry_id,
+        ).exists()
+        if already_recorded:
+            return
+        log_activity(
+            organization_id=team.organization_id,
+            team_id=team.id,
+            # AdminImpersonationMiddleware swaps request.user back to the staff member on /admin/ paths.
+            user=request.user,
+            was_impersonated=is_impersonated_session(request),
+            item_id=result.entry_id,
+            scope=AI_GATEWAY_CREDIT_SCOPE,
+            activity=AI_GATEWAY_CREDIT_ACTIVITY,
+            detail=Detail(
+                name=f"AI gateway credit (${result.amount_usd or amount})",
+                context=AIGatewayCreditActivityContext(
+                    amount_usd=result.amount_usd or str(amount),
+                    reason=reason,
+                    balance_usd=result.balance_usd,
+                ),
+            ),
+        )
+
+    @admin.display(description="Recent top-ups")
+    def ai_gateway_recent_top_ups(self, team: Team):
+        if not team.pk:
+            return "-"
+        logs = (
+            ActivityLog.objects.select_related("user")
+            .filter(team_id=team.id, scope=AI_GATEWAY_CREDIT_SCOPE, activity=AI_GATEWAY_CREDIT_ACTIVITY)
+            .order_by("-created_at")[:RECENT_AI_GATEWAY_TOP_UPS_LIMIT]
+        )
+        top_ups = []
+        for log in logs:
+            context = (log.detail or {}).get("context") or {}
+            top_ups.append(
+                {
+                    "created_at": log.created_at,
+                    "user_email": log.user.email if log.user else None,
+                    "was_impersonated": log.was_impersonated,
+                    "amount_usd": context.get("amount_usd"),
+                    "reason": context.get("reason"),
+                }
+            )
+        # nosemgrep: python.django.security.audit.avoid-mark-safe.avoid-mark-safe (admin-only, renders trusted template)
+        return mark_safe(render_to_string("admin/posthog/team/ai_gateway_recent_top_ups.html", {"top_ups": top_ups}))
+
