+    def _log_ai_gateway_credit_activity(self, request, team: Team, reason: str, result: CreditResult) -> None:
+        # The credit lands in the gateway's ledger, so it can't share a transaction with this
+        # record. Keying on the ledger entry lets an idempotent replay backfill a record an
+        # earlier attempt failed to write, without duplicating one that already exists.
+        already_logged = ActivityLog.objects.filter(
+            team_id=team.id, scope=AI_GATEWAY_CREDIT_SCOPE, item_id=result.entry_id
+        ).exists()
+        if already_logged:
+            return
+        log_activity(
+            organization_id=team.organization_id,
+            team_id=team.id,
+            user=request.user,
+            was_impersonated=is_impersonated(request),
+            item_id=result.entry_id,
+            scope=AI_GATEWAY_CREDIT_SCOPE,
+            activity="credit_added",
+            detail=Detail(
+                name=f"AI gateway credit ${result.amount_usd}",
+                context=AIGatewayCreditActivityContext(
+                    amount_usd=result.amount_usd,
+                    reason=reason,
+                    balance_usd=result.balance_usd,
+                ),
+            ),
+        )
+
+    @admin.display(description="Recent top-ups")
+    def ai_gateway_recent_top_ups(self, team: Team):
+        if not team.pk:
+            return "-"
+        top_ups = (
+            ActivityLog.objects.select_related("user")
+            .filter(team_id=team.pk, scope=AI_GATEWAY_CREDIT_SCOPE, activity="credit_added")
+            .order_by("-created_at")[:RECENT_AI_GATEWAY_TOP_UPS_LIMIT]
+        )
+        rows = []
+        for top_up in top_ups:
+            context = (top_up.detail or {}).get("context") or {}
+            rows.append(
+                {
+                    "created_at": top_up.created_at,
+                    "user_email": top_up.user.email if top_up.user else None,
+                    "was_impersonated": top_up.was_impersonated,
+                    "amount_usd": context.get("amount_usd"),
+                    "reason": context.get("reason"),
+                }
+            )
+        # nosemgrep: python.django.security.audit.avoid-mark-safe.avoid-mark-safe (admin-only, renders trusted template)
+        return mark_safe(render_to_string("admin/posthog/team/ai_gateway_recent_top_ups.html", {"top_ups": rows}))
+
