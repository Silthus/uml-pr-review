+    def _log_ai_gateway_credit_activity(self, request, team: Team, result: CreditResult, reason: str) -> None:
+        # The ledger lives in the gateway, so this record can't share its transaction. Keying
+        # on entry_id and writing whenever it's missing lets an idempotent replay backfill a
+        # record that a failed or interrupted first attempt never wrote.
+        already_logged = ActivityLog.objects.filter(
+            team_id=team.id,
+            scope=AI_GATEWAY_CREDIT_SCOPE,
+            activity=AI_GATEWAY_CREDIT_ADDED_ACTIVITY,
+            item_id=result.entry_id,
+        ).exists()
+        if already_logged:
+            return
+        log_activity(
+            organization_id=team.organization_id,
+            team_id=team.id,
+            user=request.user,
+            was_impersonated=is_impersonated(request),
+            item_id=result.entry_id,
+            scope=AI_GATEWAY_CREDIT_SCOPE,
+            activity=AI_GATEWAY_CREDIT_ADDED_ACTIVITY,
+            detail=Detail(
+                name=f"AI gateway credit ${result.amount_usd}",
+                context=AIGatewayCreditActivityContext(
+                    amount_usd=result.amount_usd,
+                    reason=reason,
+                    balance_usd=result.balance_usd,
+                ),
+            ),
+        )
+
+    @admin.display(description="Recent top-ups")
+    def ai_gateway_recent_topups(self, team: Team):
+        if not team.pk:
+            return "-"
+        logs = (
+            ActivityLog.objects.filter(
+                team_id=team.id,
+                scope=AI_GATEWAY_CREDIT_SCOPE,
+                activity=AI_GATEWAY_CREDIT_ADDED_ACTIVITY,
+            )
+            .select_related("user")
+            .order_by("-created_at")[:RECENT_AI_GATEWAY_TOPUPS_LIMIT]
+        )
+        topups = []
+        for log in logs:
+            context = (log.detail or {}).get("context") or {}
+            topups.append(
+                {
+                    "created_at": log.created_at,
+                    "user_email": log.user.email if log.user else None,
+                    "was_impersonated": bool(log.was_impersonated),
+                    "amount_usd": context.get("amount_usd"),
+                    "reason": context.get("reason"),
+                }
+            )
+        # nosemgrep: python.django.security.audit.avoid-mark-safe.avoid-mark-safe (admin-only, renders trusted template)
+        return mark_safe(
+            render_to_string("admin/posthog/team/ai_gateway_recent_topups.html", {"topups": topups}),
+        )
+
