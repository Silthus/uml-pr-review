{
  "name": "uml-pr-review",
  "version": "0.0.0",
  "private": true,
  "description": "Draws the architecture a pull request touches: files, symbols, callers, and callees, as one explorable HTML artifact.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "uml-pr-review": "./src/cli.ts"
  },
  "scripts": {
    "start": "NODE_ENV=production bun run src/server.ts",
    "dev": "bun --hot run src/server.ts",
    "cli": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@modelcontextprotocol/client": "2.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xyflow/react": "^12.12.0",
    "bun-plugin-tailwind": "^0.1.2",
    "elkjs": "^0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.6.5"
  }
}
