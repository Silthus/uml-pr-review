+/**
+ * A totality oracle whose detector is a lint rule rather than a test: the
+ * tool names an entry in the config's `lint`, the rule is the tool's own rule
+ * id, and the matching text, when given, keeps only the findings whose
+ * message carries it, since one rule id carries many patterns.
+ */
+export interface LintDetector {
+  tool: string;
+  rule: string;
+  matching: string | undefined;
+}
+
+/** How a lint via is written, for the problem that names it. The matching text holds no double quote. */
+export const LINT_VIA_FORM = 'lint <tool>:<rule> or lint <tool>:<rule> matching "<text>"';
+
+/** What a lint tool may be called, in the config and in a via. */
+export const LINT_TOOL_NAME = /^[A-Za-z0-9_.-]+$/;
+
+const LINT_VIA = /^lint\s+([A-Za-z0-9_.-]+):([^\s"]+)(?:\s+matching\s+"([^"]+)")?$/;
+
+/** Whether a via value is written in the lint form: it begins with the word lint. A test title that does is refused, not guessed at. */
+export function isLintVia(via: string): boolean {
+  return /^lint\s/.test(via);
+}
+
+/** The lint detector a via names, or undefined when the value does not read as one. */
+export function lintDetector(via: string): LintDetector | undefined {
+  const match = LINT_VIA.exec(via.trim());
+  return match === null ? undefined : { tool: match[1]!, rule: match[2]!, matching: match[3] };
+}
+
 export type Enforcement =
   | { form: "chokepoint"; protects: string; chokepoint: string; line: number }
-  | { form: "totality oracle"; over: string; via: string; line: number };
