 import { existsSync, readFileSync } from "node:fs";
 import { resolve } from "node:path";
 import { isLanguage, type Language } from "../adapters/index.ts";
+import { LINT_TOOL_NAME } from "../spec/grammar.ts";
 
 export const CONFIG_FILE = "coherence.config.json";
 export const DEFAULT_TEST_FOLDERS: readonly string[] = ["__tests__", "test", "tests"];
 
+export const LINT_FORMATS = ["oxlint-json", "ruff-json"] as const;
+export type LintFormat = (typeof LINT_FORMATS)[number];
+
+export interface LintTool {
+  command: string[];
+  format: LintFormat;
+}
+
 export interface EnforcementConfig {
   language: Language;
   /** Undefined when no test command is configured. */
@@ -41,6 +55,8 @@ export interface EnforcementConfig {
   /** How a name filter is written for the runner: an escaped regex (jest, vitest, node:test) or a pytest -k expression. */
   testFilterForm: "regex" | "pytest";
   testFolders: string[];
+  /** The linters a lint via may name, by tool; a tool absent here is not configured. */
+  lint: Record<string, LintTool>;
 }
 
 function commandValue(value: unknown): string[] | string | undefined {
@@ -50,7 +66,7 @@ function commandValue(value: unknown): string[] | string | undefined {
 }
 
 export function readEnforcementConfig(root: string): EnforcementConfig {
-  const config: EnforcementConfig = { language: "typescript", test: undefined, testMatch: undefined, testJson: undefined, testFilterForm: "regex", testFolders: [...DEFAULT_TEST_FOLDERS] };
+  const config: EnforcementConfig = { language: "typescript", test: undefined, testMatch: undefined, testJson: undefined, testFilterForm: "regex", testFolders: [...DEFAULT_TEST_FOLDERS], lint: {} };
   const path = resolve(root, CONFIG_FILE);
   if (!existsSync(path)) return config;
   let parsed: unknown;
@@ -78,5 +94,26 @@ export function readEnforcementConfig(root: string): EnforcementConfig {
   if (typeof record["testDir"] === "string") folders.add(record["testDir"]);
   if (Array.isArray(record["testDirs"])) for (const dir of record["testDirs"]) if (typeof dir === "string") folders.add(dir);
   config.testFolders = [...folders];
+  config.lint = lintTools(record["lint"], path);
   return config;
 }
+
+function lintTools(value: unknown, path: string): Record<string, LintTool> {
+  if (value === undefined) return {};
+  if (typeof value !== "object" || value === null || Array.isArray(value)) throw new Error(`${path}: lint maps a tool name to its command and format`);
+  return Object.fromEntries(Object.entries(value).map(([tool, entry]) => [tool, lintTool(tool, entry, path)]));
+}
+
+function lintTool(tool: string, entry: unknown, path: string): LintTool {
+  if (!LINT_TOOL_NAME.test(tool)) throw new Error(`${path}: lint tool ${JSON.stringify(tool)} is not a name a via can write: letters, digits, _ . and -`);
+  const record = typeof entry === "object" && entry !== null ? (entry as Record<string, unknown>) : {};
+  const command = commandValue(record["command"]);
+  const format = record["format"];
+  if (!Array.isArray(command)) throw new Error(`${path}: lint.${tool}.command is an argv array the files to check are appended to`);
+  if (!isLintFormat(format)) throw new Error(`${path}: lint.${tool}.format is ${LINT_FORMATS.join(" or ")}, not ${JSON.stringify(format)}`);
+  return { command, format };
+}
+
+function isLintFormat(value: unknown): value is LintFormat {
+  return LINT_FORMATS.some((known) => known === value);
+}
