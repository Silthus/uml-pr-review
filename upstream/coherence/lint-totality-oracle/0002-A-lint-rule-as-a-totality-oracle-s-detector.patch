+++ b/src/enforcement/lint.test.ts
@@ -0,0 +1,253 @@
+/**
+ * A lint rule as a totality oracle's detector, over a small project written
+ * into a temporary folder. The linter's output is real: the files under
+ * lint-recordings are what oxlint 1.72.0 (`oxlint -c .oxlintrc.json --format
+ * json <paths>`) and ruff 0.16.9 (`ruff check --force-exclude --output-format
+ * json <paths>`) printed for a scratch project holding the same files this
+ * fixture writes, with one import of ~/cdp, one of lodash, a debugger
+ * statement, two banned Python APIs, and, for the parse failures, a file cut
+ * off mid-edit. The project's configured lint command replays the recording
+ * for the paths it is handed, and a test that changes the tree swaps the
+ * recording with it, so the pass, refute, and the edit hook read exactly what
+ * the tool wrote for that tree.
+ */
+
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { after, before, test } from "node:test";
+import { runHook } from "../lifecycle/hook.ts";
+import { loadSpecModel } from "../spec/model.ts";
+import { refuteCommand } from "./cli.ts";
+import { readEnforcementConfig, type EnforcementConfig } from "./config.ts";
+import { lintTotalityOracle } from "./lint.ts";
+import { loadRuns } from "./record.ts";
+import { performRun } from "./run.ts";
+
+const RECORDINGS = join(dirname(fileURLToPath(import.meta.url)), "lint-recordings");
+const RUFF_RECORDED_AT = /\/tmp\/lint-record-116\/[a-z-]+/g;
+
+const INGESTION_SPEC = `# Ingestion
+
+Events in, one pipeline.
+
+## invariants
+- ingestion never reaches cdp: Ingestion code depends on CDP only through the interfaces in ~/common.
+  over: every import under src/ingestion except the listed residual: src/ingestion/legacy/replay.ts
+  via: lint oxlint:no-restricted-imports matching "~/cdp"
+  because: ingestion and CDP deploy apart, and a direct import couples their releases
+  kinds: none
+`;
+
+const PIPELINE_SPEC = `# Pipeline
+
+The steps an event passes through.
+
+## invariants
+- events keep their order: Every step hands events on in the order it received them.
+  over: every step in the pipeline
+  via: events keep their order
+  because: a reordered event reads as a later one
+  kinds: none
+`;
+
+const TRANSFORM_WITH_BYPASS = `import { HogTransformerService } from "~/cdp/hog-transformations/hog-transformer.service";
+import { debounce } from "lodash";
+
+export function transform(event: unknown): unknown {
+  debugger;
+  return new HogTransformerService(debounce).transform(event);
+}
+`;
+
+const CLEAN = `import type { HogTransformer } from "~/common/hog-transformations/hog-transformer.interface";
+
+export function clean(transformer: HogTransformer, event: unknown): unknown {
+  return transformer.transform(event);
+}
+`;
+
+const REPLAY = ["sh", "-c", 'cat "lint/$0/${1:-project}.json"; cat "lint/$0/${1:-project}.stderr" >&2 2>/dev/null'];
+
+const CONFIG = {
+  language: "typescript",
+  testJson: ["sh", "-c", 'printf "%s" "$0" > lint/batched-filter.txt', "{filter}"],
+  lint: {
+    oxlint: { command: [...REPLAY, "oxlint"], format: "oxlint-json" },
+    ruff: { command: [...REPLAY, "ruff"], format: "ruff-json" },
+  },
+};
+
+let root: string;
+
+function write(path: string, text: string): void {
+  mkdirSync(dirname(join(root, path)), { recursive: true });
+  writeFileSync(join(root, path), text, "utf8");
+}
+
+function replay(tool: string, paths: string, recording: string): void {
+  write(`lint/${tool}/${paths}.json`, readFileSync(join(RECORDINGS, recording), "utf8").replace(RUFF_RECORDED_AT, root));
+}
+
+function replaying(config: EnforcementConfig, tool: "oxlint" | "ruff", recording: string): EnforcementConfig {
+  replay(tool, "project", recording);
+  return config;
+}
+
+before(() => {
+  root = mkdtempSync(join(tmpdir(), "coherence-lint-"));
+  write("coherence.config.json", JSON.stringify(CONFIG));
+  write("src/ingestion/Ingestion.spec.md", INGESTION_SPEC);
+  write("src/pipeline/Pipeline.spec.md", PIPELINE_SPEC);
+  write("src/ingestion/transform.ts", TRANSFORM_WITH_BYPASS);
+  write("src/ingestion/clean.ts", CLEAN);
+  replay("oxlint", "project", "oxlint-1.72.0-project-bypass.json");
+  replay("oxlint", "src/ingestion/transform.ts", "oxlint-1.72.0-transform.json");
+  replay("oxlint", "src/ingestion/clean.ts", "oxlint-1.72.0-clean.json");
+  replay("oxlint", "src/ingestion/legacy/replay.ts", "oxlint-1.72.0-no-files.json");
+  replay("ruff", "project", "ruff-0.16.9-project.json");
+});
+
+after(() => {
+  rmSync(root, { recursive: true, force: true });
+});
+
+test("each lint format reads its tool's own JSON report: the findings of the named rule, kept by the matching text, at their file and line", async () => {
+  const config = readEnforcementConfig(root);
+  const cdp = await lintTotalityOracle(root, config, { tool: "oxlint", rule: "no-restricted-imports", matching: "~/cdp" });
+  assert.equal(cdp.verdict, "fail", cdp.reason);
+  assert.deepEqual(cdp.findings, [
+    {
+      file: "src/ingestion/transform.ts",
+      line: 1,
+      message: "'~/cdp/hog-transformations/hog-transformer.service' import is restricted from being used by a pattern. ingestion never reaches cdp (Ingestion.spec.md): depend on the interfaces in ~/common",
+    },
+  ]);
+  const everyRestriction = await lintTotalityOracle(root, config, { tool: "oxlint", rule: "eslint/no-restricted-imports", matching: undefined });
+  assert.deepEqual(everyRestriction.findings.map((f) => `${f.file}:${f.line}`), ["src/ingestion/transform.ts:1", "src/ingestion/transform.ts:2"]);
+
+  const banned = await lintTotalityOracle(root, config, { tool: "ruff", rule: "TID251", matching: "is_impersonated_session" });
+  assert.equal(banned.verdict, "fail", banned.reason);
+  assert.deepEqual(banned.findings, [
+    {
+      file: "posthog/admin/team_admin.py",
+      line: 3,
+      message: "`loginas.utils.is_impersonated_session` is banned: impersonation is read through is_impersonated (Admin.spec.md): use posthog.helpers.impersonation.is_impersonated",
+    },
+  ]);
+  const byName = await lintTotalityOracle(root, config, { tool: "ruff", rule: "banned-api", matching: undefined });
+  assert.deepEqual(byName.findings.map((f) => `${f.file}:${f.line}`), ["posthog/admin/team_admin.py:3", "posthog/admin/team_admin.py:7"]);
+
+  const otherText = await lintTotalityOracle(root, config, { tool: "oxlint", rule: "no-restricted-imports", matching: "~/scenes" });
+  assert.equal(otherText.verdict, "pass", otherText.reason);
+  assert.deepEqual(otherText.findings, []);
+});
+
+test("a lint tool that is not configured, whose output is not its format, that linted no file, or that could not parse a file is not run, never a pass", async (t) => {
+  t.after(() => {
+    replay("oxlint", "project", "oxlint-1.72.0-project-bypass.json");
+    replay("ruff", "project", "ruff-0.16.9-project.json");
+    rmSync(join(root, "lint/ruff/project.stderr"), { force: true });
+  });
+  const config = readEnforcementConfig(root);
+  const cdp = { tool: "oxlint", rule: "no-restricted-imports", matching: "~/cdp" };
+  const banned = { tool: "ruff", rule: "TID251", matching: "is_impersonated_session" };
+  const verdictOf = async (checked: EnforcementConfig, via: typeof cdp): Promise<[string, string]> => {
+    const result = await lintTotalityOracle(root, checked, via);
+    return [result.verdict, result.reason];
+  };
+
+  const [unconfigured, unconfiguredReason] = await verdictOf(config, { tool: "semgrep", rule: "no-env", matching: "environ" });
+  assert.equal(unconfigured, "not run");
+  assert.match(unconfiguredReason, /no lint tool "semgrep" is configured/);
+
+  write("lint/oxlint/project.json", "Error: failed to parse .oxlintrc.json\n");
+  const [garbled, garbledReason] = await verdictOf(config, cdp);
+  assert.equal(garbled, "not run");
+  assert.match(garbledReason, /is not oxlint-json/);
+
+  const [noFile, noFileReason] = await verdictOf(replaying(config, "oxlint", "oxlint-1.72.0-no-files.json"), cdp);
+  assert.equal(noFile, "not run");
+  assert.match(noFileReason, /linted no file/);
+
+  write("lint/ruff/project.stderr", readFileSync(join(RECORDINGS, "ruff-0.16.9-no-files.stderr"), "utf8"));
+  const [noPython, noPythonReason] = await verdictOf(replaying(config, "ruff", "ruff-0.16.9-no-files.json"), banned);
+  assert.equal(noPython, "not run");
+  assert.match(noPythonReason, /linted no file/);
+  rmSync(join(root, "lint/ruff/project.stderr"));
+
+  const [halfWritten, halfWrittenReason] = await verdictOf(replaying(config, "oxlint", "oxlint-1.72.0-parse-failure.json"), cdp);
+  assert.equal(halfWritten, "not run");
+  assert.match(halfWrittenReason, /1 file did not parse, so oxlint:no-restricted-imports matching "~\/cdp" was not checked there: src\/ingestion\/half-written\.ts/);
+
+  const [halfWrittenPython, halfWrittenPythonReason] = await verdictOf(replaying(config, "ruff", "ruff-0.16.9-parse-failure.json"), banned);
+  assert.equal(halfWrittenPython, "not run");
+  assert.match(halfWrittenPythonReason, /1 file did not parse, .* posthog\/admin\/half_written\.py/);
+});
+
+test("a lint totality oracle is refuted red with the break staged, and a later run finds it green: the refutation is witnessed", async (t) => {
+  t.after(() => {
+    write("src/ingestion/transform.ts", TRANSFORM_WITH_BYPASS);
+    replay("oxlint", "project", "oxlint-1.72.0-project-bypass.json");
+    rmSync(join(root, ".coherence"), { recursive: true, force: true });
+  });
+  const lines: string[] = [];
+  const errors: string[] = [];
+  const io = { cwd: root, out: (line: string) => lines.push(line), err: (line: string) => errors.push(line) };
+  const bullet = "src/ingestion/ingestion never reaches cdp";
+  const state = (): string => loadSpecModel(root).components.find((c) => c.folder === "src/ingestion")!.invariants[0]!.state;
+
+  const refuted = await refuteCommand([bullet, "--broke", "imported the hog transformer service from ~/cdp in transform.ts", "--session", "l1", "--agent", "lint"], io);
+  assert.equal(refuted, 0, errors.join("\n"));
+  assert.match(lines.join("\n"), /the detector went red: 1 finding of oxlint:no-restricted-imports matching "~\/cdp", the first at src\/ingestion\/transform\.ts:1/);
+  assert.deepEqual(loadRuns(root).refutations.map((r) => [r.component, r.name, r.verdict]), [["src/ingestion", "ingestion never reaches cdp", "fail"]]);
+  assert.equal(state(), "requirement", "the red detector alone is not a witnessed refutation");
+
+  rmSync(join(root, "src/ingestion/transform.ts"));
+  replay("oxlint", "project", "oxlint-1.72.0-project-clean.json");
+  const green = await performRun(root, { session: "l1", agent: "lint", server: false });
+  const entry = green.record.invariants.find((e) => e.component === "src/ingestion")!;
+  assert.deepEqual([entry.verdict, entry.refutation, entry.mode], ["pass", "witnessed", undefined]);
+  assert.match(entry.reason, /reported no finding of oxlint:no-restricted-imports matching "~\/cdp" in 1 file/);
+  assert.equal(state(), "invariant");
+});
+
+test("the batched test invocation carries the test titles alone: a lint via never reaches the test runner", async (t) => {
+  t.after(() => rmSync(join(root, ".coherence"), { recursive: true, force: true }));
+  const outcome = await performRun(root, { session: "b1", agent: "lint", server: false, form: "totality oracle" });
+  assert.equal(readFileSync(join(root, "lint/batched-filter.txt"), "utf8"), "events keep their order");
+  assert.deepEqual(outcome.record.invariants.map((e) => [e.name, e.mode]), [
+    ["ingestion never reaches cdp", undefined],
+    ["events keep their order", "batched"],
+  ]);
+});
+
+test("PostToolUse lints the written file only: a finding prints the invariant, the site, and the two honest options; a clean file, the listed residual, and a file no linter reads say nothing", async () => {
+  const edit = (file: string, text: string) => {
+    write(file, text);
+    return runHook("PostToolUse", { cwd: root, session_id: "h1", tool_name: "Write", tool_input: { file_path: join(root, file) } }, root);
+  };
+
+  const dirty = await edit("src/ingestion/transform.ts", TRANSFORM_WITH_BYPASS);
+  assert.equal(dirty.exit, 0, dirty.stderr);
+  const context = (JSON.parse(dirty.stdout) as { hookSpecificOutput: { additionalContext: string } }).hookSpecificOutput.additionalContext;
+  assert.equal(
+    context.split("\n").slice(0, 3).join("\n"),
+    [
+      "Structural defect revealed at this edit (src/ingestion/transform.ts):",
+      `✕ src/ingestion/ingestion never reaches cdp — totality oracle lint oxlint:no-restricted-imports matching "~/cdp" over every import under src/ingestion except the listed residual: src/ingestion/legacy/replay.ts`,
+      "    src/ingestion/transform.ts:1 '~/cdp/hog-transformations/hog-transformer.service' import is restricted from being used by a pattern. ingestion never reaches cdp (Ingestion.spec.md): depend on the interfaces in ~/common",
+    ].join("\n"),
+  );
+  assert.match(context, /Two honest options: change the site so the rule no longer reports it, or escalate a retirement for a human, who must acknowledge it/);
+  assert.match(context, /escalate "retire <invariant>" .* --session h1 --agent main/);
+  assert.doesNotMatch(context, /lodash/, "a finding of the rule that does not carry the matching text is not this invariant's");
+  assert.equal(loadRuns(root).records.length, 0, "one file is not the named set, so the edit check appends no run");
+
+  const silent = { stdout: "", stderr: "", exit: 0 };
+  assert.deepEqual(await edit("src/ingestion/clean.ts", CLEAN), silent);
+  assert.deepEqual(await edit("src/ingestion/legacy/replay.ts", TRANSFORM_WITH_BYPASS), silent, "the lint config excludes the listed residual, so oxlint linted no file");
+  assert.deepEqual(await edit("src/ingestion/NOTES.md", "Notes.\n"), silent, "no linter is handed a file it does not lint, so no replay was asked for");
+});
