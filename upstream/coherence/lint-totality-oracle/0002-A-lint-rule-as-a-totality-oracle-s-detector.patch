index 0000000..67c3f98
--- /dev/null
+++ b/src/enforcement/lint.ts
@@ -0,0 +1,259 @@
+/**
+ * A lint rule as a totality oracle's detector: `via: lint <tool>:<rule>` runs
+ * the command the config names for the tool, reads its report in the tool's
+ * format, and keeps the findings of that rule whose message carries the
+ * matching text. The verdict is fail with any finding and pass with none. It
+ * is not run when the tool is not configured, cannot start, or writes a
+ * report that is not its format; when the tool says it linted no file; and
+ * when a file did not parse, since a linter checks no rule in a file it
+ * cannot parse. A detector that looked at nothing is never a pass. The set
+ * it is total over is the lint config's own: what the config excludes is the
+ * listed residual the bullet's `over:` names, and there is no count and no
+ * stored list of known findings.
+ *
+ * One module, three callers: the run's totality pass over the whole project,
+ * `refute` through that same pass, and the edit hook on the written files
+ * only, which the command is handed as trailing arguments. Each tool runs
+ * once per call, however many totality oracles name it, and a scoped call
+ * hands a tool only the files it lints.
+ */
+
+import { spawn } from "node:child_process";
+import { extname, relative, resolve, sep } from "node:path";
+import type { LintDetector } from "../spec/grammar.ts";
+import { LINT_FORMATS, type EnforcementConfig, type LintFormat } from "./config.ts";
+import { TOTALITY_TIMEOUT_MS, killTree, type TotalityResult } from "./totality.ts";
+
+export interface LintFinding {
+  /** Project-relative, with forward slashes. */
+  file: string;
+  line: number;
+  message: string;
+}
+
+export interface LintResult extends TotalityResult {
+  findings: LintFinding[];
+}
+
+interface Diagnostic {
+  /** Every id the tool knows the rule by. */
+  rules: string[];
+  file: string;
+  line: number;
+  message: string;
+  /** The tool could not parse the file, so it checked no rule there. */
+  unparsed: boolean;
+}
+
+interface LintReport {
+  diagnostics: Diagnostic[];
+  /** How many files the tool linted, where it says. */
+  linted: number | undefined;
+}
+
+type ToolOutcome =
+  | { kind: "not run"; reason: string; command: string | undefined; tail: string }
+  | { kind: "unfinished"; reason: string; command: string; tail: string }
+  | { kind: "outside"; handed: number }
+  | { kind: "report"; report: LintReport; command: string };
+
+type Heard =
+  | { kind: "exited"; code: number | null; stdout: string; stderr: string }
+  | { kind: "unstarted"; reason: string }
+  | { kind: "unfinished"; stdout: string; stderr: string };
+
+interface Format {
+  /** The file extensions the tool lints; a scoped call hands it no other file. */
+  extensions: readonly string[];
+  read(stdout: string, stderr: string): LintReport;
+}
+
+const FORMATS: Record<LintFormat, Format> = {
+  "oxlint-json": { extensions: [".js", ".mjs", ".cjs", ".jsx", ".ts", ".mts", ".cts", ".tsx", ".vue", ".svelte", ".astro"], read: readOxlintJson },
+  "ruff-json": { extensions: [".py", ".pyi", ".ipynb"], read: readRuffJson },
+};
+
+export async function lintTotalityOracle(root: string, config: EnforcementConfig, via: LintDetector, files?: readonly string[], timeoutMs = TOTALITY_TIMEOUT_MS): Promise<LintResult> {
+  const [result] = await lintTotalityOracles(root, config, [via], files, timeoutMs);
+  return result!;
+}
+
+/** Every lint totality oracle named, in order, with each tool run once. */
+export async function lintTotalityOracles(root: string, config: EnforcementConfig, vias: readonly LintDetector[], files?: readonly string[], timeoutMs = TOTALITY_TIMEOUT_MS): Promise<LintResult[]> {
+  const tools = [...new Set(vias.map((via) => via.tool))];
+  const outcomes = new Map(await Promise.all(tools.map(async (tool) => [tool, await runTool(root, config, tool, files, timeoutMs)] as const)));
+  return vias.map((via) => judge(root, via, outcomes.get(via.tool)!, files === undefined));
+}
+
+async function runTool(root: string, config: EnforcementConfig, name: string, files: readonly string[] | undefined, timeoutMs: number): Promise<ToolOutcome> {
+  const tool = config.lint[name];
+  if (tool === undefined) {
+    return { kind: "not run", reason: `no lint tool "${name}" is configured; add lint.${name} to coherence.config.json with its command and its format (${LINT_FORMATS.join(" or ")})`, command: undefined, tail: "" };
+  }
+  const format = FORMATS[tool.format];
+  const handed = files?.filter((file) => format.extensions.includes(extname(file).toLowerCase()));
+  if (files !== undefined && handed!.length === 0) return { kind: "outside", handed: files.length };
+  const [command, ...args] = tool.command;
+  const shown = [command!, ...args].map((a) => (/\s/.test(a) ? JSON.stringify(a) : a)).join(" ");
+  const heard = await capture(root, command!, [...args, ...(handed ?? [])], timeoutMs);
+  if (heard.kind === "unstarted") return { kind: "not run", reason: `lint command could not start: ${heard.reason}`, command: shown, tail: "" };
+  if (heard.kind === "unfinished") {
+    return { kind: "unfinished", reason: `the detector did not finish in ${Math.round(timeoutMs / 1000)} s; its lint process and every process it started were killed`, command: shown, tail: lastLines(heard.stdout + heard.stderr) };
+  }
+  try {
+    return { kind: "report", report: format.read(heard.stdout, heard.stderr), command: shown };
+  } catch (error) {
+    return { kind: "not run", reason: `${shown} exited ${heard.code} and its output is not ${tool.format} (${error instanceof Error ? error.message : String(error)})`, command: shown, tail: lastLines(heard.stdout + heard.stderr) };
+  }
+}
+
+function judge(root: string, via: LintDetector, outcome: ToolOutcome, whole: boolean): LintResult {
+  if (outcome.kind === "not run") return { verdict: "not run", reason: outcome.reason, command: outcome.command, tail: outcome.tail, findings: [] };
+  if (outcome.kind === "unfinished") return { verdict: "fail", reason: outcome.reason, command: outcome.command, tail: outcome.tail, findings: [], unfinished: true };
+  if (outcome.kind === "outside") return { verdict: "pass", reason: `none of the ${outcome.handed} files handed to it is a file ${via.tool} lints`, command: undefined, tail: "", findings: [] };
+  const { report, command } = outcome;
+  if (report.linted === 0 && whole) return { verdict: "not run", reason: `${command} linted no file, so ${named(via)} was checked over nothing`, command, tail: "", findings: [] };
+  const found = (d: Diagnostic): LintFinding => ({ file: projectPath(root, d.file), line: d.line, message: d.message });
+  const findings = report.diagnostics.filter((d) => d.rules.includes(via.rule) && (via.matching === undefined || d.message.includes(via.matching))).map(found);
+  if (findings.length > 0) {
+    const first = findings[0]!;
+    return {
+      verdict: "fail",
+      reason: `${findings.length} finding${findings.length === 1 ? "" : "s"} of ${named(via)}, the first at ${first.file}:${first.line}`,
+      command,
+      tail: firstLines(findings.map((f) => `${f.file}:${f.line} ${f.message}`)),
+      findings,
+    };
+  }
+  const unparsed = report.diagnostics.filter((d) => d.unparsed).map(found);
+  if (unparsed.length > 0) {
+    const files = [...new Set(unparsed.map((u) => u.file))];
+    return {
+      verdict: "not run",
+      reason: `${files.length} file${files.length === 1 ? "" : "s"} did not parse, so ${named(via)} was not checked there: ${files.slice(0, 3).join(", ")}`,
+      command,
+      tail: firstLines(unparsed.map((u) => `${u.file}:${u.line} ${u.message}`)),
+      findings: [],
+    };
+  }
+  return { verdict: "pass", reason: `${command} reported no finding of ${named(via)}${lintedText(report.linted)}`, command, tail: "", findings: [] };
+}
+
+/** The detector as the bullet wrote it, for a reason. */
+function named(via: LintDetector): string {
+  return `${via.tool}:${via.rule}${via.matching === undefined ? "" : ` matching "${via.matching}"`}`;
+}
+
+function lintedText(linted: number | undefined): string {
+  if (linted === undefined) return "";
+  if (linted === 0) return ": none of the files handed to it is in its set";
+  return ` in ${linted} file${linted === 1 ? "" : "s"}`;
+}
+
+function projectPath(root: string, file: string): string {
+  return relative(resolve(root), resolve(root, file)).split(sep).join("/");
+}
+
+function firstLines(lines: string[], count = 12): string {
+  return lines.slice(0, count).join("\n");
+}
+
+function lastLines(output: string, count = 12): string {
+  return output.split("\n").filter((l) => l.trim() !== "").slice(-count).join("\n");
+}
+
+function capture(root: string, command: string, args: string[], timeoutMs: number): Promise<Heard> {
+  return new Promise((resolveHeard) => {
+    let stdout = "";
+    let stderr = "";
+    let settled = false;
+    let timer: NodeJS.Timeout | undefined;
+    const finish = (heard: Heard): void => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      resolveHeard(heard);
+    };
+    let child;
+    try {
+      child = spawn(command, args, { cwd: root, stdio: ["ignore", "pipe", "pipe"] });
+    } catch (error) {
+      finish({ kind: "unstarted", reason: error instanceof Error ? error.message : String(error) });
+      return;
+    }
+    timer = setTimeout(() => {
+      killTree(child.pid);
+      finish({ kind: "unfinished", stdout, stderr });
+    }, timeoutMs);
+    child.stdout.on("data", (chunk: Buffer) => (stdout += chunk.toString("utf8")));
+    child.stderr.on("data", (chunk: Buffer) => (stderr += chunk.toString("utf8")));
+    child.on("error", (error) => finish({ kind: "unstarted", reason: error.message }));
+    child.on("close", (code) => finish({ kind: "exited", code, stdout, stderr }));
+  });
+}
+
+/* ------------------------------------------------------------- formats */
+
+interface OxlintDiagnostic {
+  message?: string;
+  code?: string;
+  help?: string;
+  filename?: string;
+  labels?: { span?: { line?: number } }[];
+}
+
+/**
+ * oxlint's `--format json`: one object with `diagnostics` and
+ * `number_of_files`. A run that found no file prints a sentence before the
+ * object, so the report starts at the first brace. A rule is known by its
+ * code as printed, `eslint(no-restricted-imports)`, by its bare name, and by
+ * the `plugin/rule` name a config writes. A diagnostic with no code is the
+ * parser's: the file did not parse.
+ */
+function readOxlintJson(stdout: string): LintReport {
+  const start = stdout.indexOf("{");
+  if (start < 0) throw new Error("no JSON object in its output");
+  const parsed = JSON.parse(stdout.slice(start)) as { diagnostics?: unknown; number_of_files?: unknown };
+  if (!Array.isArray(parsed.diagnostics)) throw new Error("no diagnostics array");
+  const diagnostics = (parsed.diagnostics as OxlintDiagnostic[]).map((d) => ({
+    rules: oxlintRuleIds(d.code ?? ""),
+    file: d.filename ?? "",
+    line: d.labels?.[0]?.span?.line ?? 1,
+    message: d.help === undefined || d.help === "" ? (d.message ?? "") : `${d.message ?? ""} ${d.help}`,
+    unparsed: d.code === undefined || d.code === "",
+  }));
+  return { diagnostics, linted: typeof parsed.number_of_files === "number" ? parsed.number_of_files : undefined };
+}
+
+function oxlintRuleIds(code: string): string[] {
+  const scoped = /^(.+)\((.+)\)$/.exec(code);
+  return scoped === null ? [code] : [code, scoped[2]!, `${scoped[1]}/${scoped[2]}`];
+}
+
+interface RuffDiagnostic {
+  code?: string | null;
+  name?: string;
+  filename?: string;
+  location?: { row?: number };
+  message?: string;
+}
+
+/**
+ * ruff's `--output-format json`: an array of diagnostics with an absolute
+ * `filename`. A rule is known by its code and by its name; `invalid-syntax`,
+ * like any diagnostic without a code, is the parser's. ruff reports no file
+ * count; it says it linted none only when it warns that it found no Python
+ * file, and it does not always warn.
+ */
+function readRuffJson(stdout: string, stderr: string): LintReport {
+  const parsed = JSON.parse(stdout) as unknown;
+  if (!Array.isArray(parsed)) throw new Error("not a JSON array of diagnostics");
+  const diagnostics = (parsed as RuffDiagnostic[]).map((d) => ({
+    rules: [d.code, d.name].filter((id): id is string => typeof id === "string" && id !== ""),
+    file: d.filename ?? "",
+    line: d.location?.row ?? 1,
+    message: d.message ?? "",
+    unparsed: d.code === null || d.code === undefined || d.code === "invalid-syntax",
+  }));
+  return { diagnostics, linted: /No Python files found/.test(stderr) ? 0 : undefined };
+}
