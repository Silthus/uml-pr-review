diff --git a/src/adapters/lint-guards.ts b/src/adapters/lint-guards.ts
new file mode 100644
index 0000000..88ab50d
--- /dev/null
+++ b/src/adapters/lint-guards.ts
@@ -0,0 +1,167 @@
+import { existsSync, readFileSync, statSync } from "node:fs";
+import { isAbsolute, join, posix, relative, sep } from "node:path";
+import { parseSpec, type Enforcement, type ParsedSpec } from "../spec/grammar.ts";
+import { CONFIG_FILE, declaresAtTop, findSpecs, readConfig } from "../spec/model.ts";
+import { parseName } from "./adapter.ts";
+import { projectFiles } from "./project-files.ts";
+
+export interface LintGuard {
+  invariant: string;
+  spec: string;
+  protects: string;
+  chokepoint: string;
+  because: string;
+  protectedFile: string;
+  chokepointFile: string;
+}
+
+export interface LintProblem {
+  spec: string;
+  folder: string;
+  reason: string;
+}
+
+export interface LintGuards {
+  guards: LintGuard[];
+  problems: LintProblem[];
+  read: string[];
+}
+
+type ChokepointForm = Extract<Enforcement, { form: "chokepoint" }>;
+
+export function readLintGuards(root: string): LintGuards {
+  if (!existsSync(join(root, CONFIG_FILE))) {
+    return { guards: [], problems: [{ spec: CONFIG_FILE, folder: ".", reason: "no such file at the rule's root; set root to the folder that holds it" }], read: [] };
+  }
+  let specs: string[];
+  try {
+    specs = findSpecs(root, readConfig(root).ignore).map((path) => projectRelative(root, path) ?? path);
+  } catch (error) {
+    return { guards: [], problems: [{ spec: CONFIG_FILE, folder: ".", reason: withoutRoot(root, error) }], read: [CONFIG_FILE] };
+  }
+  const files = projectFiles(root).filter((file) => file.split("/").every((part) => !part.startsWith(".")));
+  const guards: LintGuard[] = [];
+  const problems: LintProblem[] = [];
+  for (const spec of specs) {
+    const folder = posix.dirname(spec);
+    const parsed = readSpec(root, spec);
+    if (typeof parsed === "string") {
+      problems.push({ spec, folder, reason: parsed });
+      continue;
+    }
+    for (const invariant of parsed.invariants) {
+      for (const enforcement of invariant.enforcements) {
+        if (enforcement.form !== "chokepoint") continue;
+        const guard = guardOf(root, files, folder, enforcement);
+        if (typeof guard === "string") problems.push({ spec, folder, reason: `the invariant "${invariant.name}" ${guard}` });
+        else if (guard !== undefined) guards.push({ invariant: invariant.name, spec, protects: enforcement.protects, chokepoint: enforcement.chokepoint, because: invariant.because ?? invariant.sentence, ...guard });
+      }
+    }
+  }
+  return { guards, problems, read: [CONFIG_FILE, ...specs] };
+}
+
+export function stampOf(root: string, read: readonly string[]): string {
+  return read.map((file) => modifiedAt(join(root, file))).join(",");
+}
+
+function readSpec(root: string, spec: string): ParsedSpec | string {
+  let parsed: ParsedSpec;
+  try {
+    parsed = parseSpec(readFileSync(join(root, spec), "utf8"), spec);
+  } catch (error) {
+    return withoutRoot(root, error);
+  }
+  const problem = parsed.problems[0];
+  return problem === undefined ? parsed : `line ${problem.line}: ${problem.message}`;
+}
+
+function guardOf(root: string, files: readonly string[], folder: string, enforcement: ChokepointForm): { protectedFile: string; chokepointFile: string } | string | undefined {
+  const protects = parseName(enforcement.protects);
+  if (protects.form !== "module") return undefined;
+  const protectedFile = protects.path;
+  if (!isFile(join(root, protectedFile))) return `protects ${protectedFile}, which is not a file under the rule's root`;
+  const chokepoint = parseName(enforcement.chokepoint);
+  if (chokepoint.form === "module") return isFile(join(root, chokepoint.path)) ? { protectedFile, chokepointFile: chokepoint.path } : `names the chokepoint ${chokepoint.path}, which is not a file under the rule's root`;
+  if (chokepoint.form !== "symbol" || chokepoint.fileHint === undefined) return undefined;
+  const hint = chokepoint.fileHint;
+  const declaring = files.filter((file) => (file === hint || file.endsWith("/" + hint)) && declaresAtTop(textOf(join(root, file)), chokepoint.name));
+  const chosen = declaring.length === 1 ? declaring : declaring.filter((file) => covers(folder, file));
+  if (chosen.length === 1) return { protectedFile, chokepointFile: chosen[0]! };
+  return `names the chokepoint ${enforcement.chokepoint}, which ${declaring.length === 0 ? "no file declares" : `${declaring.length} files declare`}; write the chokepoint's module path`;
+}
+
+export function covers(folder: string, file: string): boolean {
+  return folder === "." || file.startsWith(folder + "/");
+}
+
+export function isFile(path: string): boolean {
+  try {
+    return statSync(path).isFile();
+  } catch {
+    return false;
+  }
+}
+
+function textOf(path: string): string {
+  try {
+    return readFileSync(path, "utf8");
+  } catch {
+    return "";
+  }
+}
+
+function modifiedAt(path: string): number {
+  try {
+    return statSync(path).mtimeMs;
+  } catch {
+    return -1;
+  }
+}
+
+export function projectRelative(root: string, path: string): string | undefined {
+  const rel = relative(root, path).split(sep).join("/");
+  return rel === "" || rel === ".." || rel.startsWith("../") || isAbsolute(rel) ? undefined : rel;
+}
+
+function withoutRoot(root: string, error: unknown): string {
+  return (error as Error).message.split(join(root, "/")).join("");
+}
+
+export function readJsonc(text: string): unknown {
+  let plain = "";
+  let pendingComma = "";
+  const body = text.replace(/^﻿/, "");
+  for (let i = 0; i < body.length; i++) {
+    const char = body[i]!;
+    if (char === '"') {
+      const end = stringEnd(body, i);
+      plain += pendingComma + body.slice(i, end);
+      pendingComma = "";
+      i = end - 1;
+    } else if (char === "/" && body[i + 1] === "/") {
+      const end = body.indexOf("\n", i);
+      i = end === -1 ? body.length : end - 1;
+    } else if (char === "/" && body[i + 1] === "*") {
+      const end = body.indexOf("*/", i + 2);
+      i = end === -1 ? body.length : end + 1;
+    } else if (char === ",") {
+      plain += pendingComma;
+      pendingComma = ",";
+    } else if (/\s/.test(char)) {
+      plain += char;
+    } else {
+      plain += (char === "}" || char === "]" ? "" : pendingComma) + char;
+      pendingComma = "";
+    }
+  }
+  return JSON.parse(plain + pendingComma);
+}
+
+function stringEnd(text: string, start: number): number {
+  for (let i = start + 1; i < text.length; i++) {
+    if (text[i] === "\\") i++;
+    else if (text[i] === '"') return i + 1;
+  }
+  return text.length;
+}
