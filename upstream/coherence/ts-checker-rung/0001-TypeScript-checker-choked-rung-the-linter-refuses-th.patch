+++ b/src/adapters/lint.test.ts
@@ -0,0 +1,205 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { after, before, test } from "node:test";
+import { checkChokepoint } from "../enforcement/check.ts";
+import { readEnforcementConfig } from "../enforcement/config.ts";
+import { TypeScriptAdapter } from "./typescript.ts";
+
+const OXLINT = fileURLToPath(new URL("../../node_modules/.bin/oxlint", import.meta.url));
+const PLUGIN = fileURLToPath(new URL("./lint.ts", import.meta.url));
+
+const TSCONFIG = `{
+  // the project's alias points elsewhere; src/tsconfig.json is nearer to the code
+  "compilerOptions": { "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "paths": { "~/*": ["./frontend/*"] } },
+  "include": ["src/**/*.ts"],
+}
+`;
+
+const SRC_TSCONFIG = `{ "extends": "../tsconfig.json", "compilerOptions": { "paths": { "~/*": ["./*"] } } }
+`;
+
+const STORE_SPEC = (chokepoint: string): string => `# Store
+
+The secret store, reached through its door.
+
+## invariants
+- one door: The secret store is reached only through its door.
+  protects: src/store/secrets.ts
+  chokepoint: ${chokepoint}
+  because: a caller that reads the store directly skips the sealing the door does
+  kinds: none
+`;
+
+const SECRETS = `export const SECRET_COLUMNS: Record<string, string[]> = { tokens: ["token"] };
+`;
+
+const DOOR = `import { SECRET_COLUMNS } from "./secrets.ts";
+
+export function seal(pattern: string, row: Record<string, unknown>): Record<string, unknown> {
+  const out = { ...row };
+  for (const column of SECRET_COLUMNS[pattern] ?? []) delete out[column];
+  return out;
+}
+`;
+
+const RENDER = `import { seal } from "../store/door.ts";
+
+export function render(row: Record<string, unknown>): string {
+  return JSON.stringify(seal("tokens", row));
+}
+`;
+
+const TEST_HELPER = `import { SECRET_COLUMNS } from "../store/secrets.ts";
+export const columns = SECRET_COLUMNS;
+`;
+
+const BYPASS = `src/store/secrets.ts is protected by the invariant "one door" in src/store/Store.spec.md: reach it through seal in door.ts. Because: a caller that reads the store directly skips the sealing the door does`;
+const RE_EXPORT = `Re-exporting src/store/secrets.ts widens its reach past seal in door.ts (invariant "one door" in src/store/Store.spec.md). Remove the re-export.`;
+
+let root: string;
+let adapter: TypeScriptAdapter;
+
+function write(path: string, text: string): void {
+  mkdirSync(dirname(join(root, path)), { recursive: true });
+  writeFileSync(join(root, path), text, "utf8");
+}
+
+function remove(path: string): void {
+  rmSync(join(root, path), { force: true });
+}
+
+function oxlintConfig(rules: Record<string, unknown>, extra: Record<string, unknown> = {}, plugin: string = PLUGIN): string {
+  return JSON.stringify({ jsPlugins: [plugin], categories: { correctness: "off" }, rules, ...extra }, null, 2);
+}
+
+function lint(from: string = "."): string[] {
+  const cwd = join(root, from);
+  const run = spawnSync(OXLINT, ["-c", join(root, ".oxlintrc.json"), "--format", "json", "."], { cwd, encoding: "utf8" });
+  assert.ok(run.stdout.trim().startsWith("{"), `oxlint gave no report: ${run.stderr}`);
+  const report = JSON.parse(run.stdout) as { diagnostics: { message: string; code: string; filename: string; labels: { span: { line: number } }[] }[] };
+  return report.diagnostics
+    .filter((d) => d.code === "coherence(chokepoint)")
+    .map((d) => `${d.filename}:${d.labels[0]?.span.line} ${d.message}`)
+    .sort();
+}
+
+before(() => {
+  root = mkdtempSync(join(tmpdir(), "coherence-lint-"));
+  write("tsconfig.json", TSCONFIG);
+  write("src/tsconfig.json", SRC_TSCONFIG);
+  write("coherence.config.json", JSON.stringify({ language: "typescript", testDir: "__tests__" }));
+  write("src/store/Store.spec.md", STORE_SPEC("seal in door.ts"));
+  write("src/store/secrets.ts", SECRETS);
+  write("src/store/door.ts", DOOR);
+  write("src/api/render.ts", RENDER);
+  write("src/__tests__/columns.ts", TEST_HELPER);
+  write(".oxlintrc.json", oxlintConfig({ "coherence/chokepoint": "error" }));
+  adapter = new TypeScriptAdapter(root);
+});
+
+after(async () => {
+  await adapter.close();
+  rmSync(root, { recursive: true, force: true });
+});
+
+test("coherence/chokepoint under oxlint: an import or a re-export outside the chokepoint goes red, a test is exempt, and removing the bypass goes green", () => {
+  assert.deepEqual(lint(), [], "the door imports the store, and a file in a test folder may too");
+
+  write("src/api/leak.ts", `import { SECRET_COLUMNS } from "../store/secrets.ts";\nexport const leaked = SECRET_COLUMNS;\n`);
+  write("src/api/lazy.ts", `export async function columns(): Promise<unknown> {\n  return (await import("~/store/secrets")).SECRET_COLUMNS;\n}\n`);
+  write("src/api/required.ts", `import store = require("../store/secrets");\nexport const columns = store.SECRET_COLUMNS;\n`);
+  write("src/api/typed.ts", `export type Store = typeof import("../store/secrets.js");\n`);
+  write("src/api/widen.ts", `export * from "../store/secrets.ts";\n`);
+  write("src/store/door.ts", `${DOOR}export { SECRET_COLUMNS } from "./secrets.ts";\n`);
+  assert.deepEqual(lint(), [
+    `src/api/lazy.ts:2 ${BYPASS}`,
+    `src/api/leak.ts:1 ${BYPASS}`,
+    `src/api/required.ts:1 ${BYPASS}`,
+    `src/api/typed.ts:1 ${BYPASS}`,
+    `src/api/widen.ts:1 ${RE_EXPORT}`,
+    `src/store/door.ts:8 ${RE_EXPORT}`,
+  ]);
+
+  for (const staged of ["leak", "lazy", "required", "typed", "widen"]) remove(`src/api/${staged}.ts`);
+  write("src/store/door.ts", DOOR);
+  assert.deepEqual(lint(), []);
+});
+
+test("coherence/chokepoint under oxlint: a spec, a bullet or a configuration Coherence cannot read is reported at line 1 of each file under its component, never thrown", () => {
+  write("src/api/Api.spec.md", "# Api\n\nThe api.\n\n## rules\n- x: y\n");
+  write("src/lib/Lib.spec.md", "# Lib\n\nThe library.\n\n## invariants\n- gone: A module that moved.\n  protects: src/lib/gone.ts\n  chokepoint: src/lib/door.ts\n  because: it moved\n  kinds: none\n");
+  write("src/lib/door.ts", "export const door = 1;\n");
+  write("src/api/leak.ts", `import { SECRET_COLUMNS } from "../store/secrets.ts";\nexport const leaked = SECRET_COLUMNS;\n`);
+  const unreadable = `Coherence could not read src/api/Api.spec.md: line 5: unknown section "rules": a spec holds ## trust levels (entry spec only), ## entrances and ## invariants`;
+  const unresolved = `Coherence could not read src/lib/Lib.spec.md: the invariant "gone" protects src/lib/gone.ts, which is not a file under the rule's root`;
+  assert.deepEqual(lint(), [
+    `src/api/leak.ts:1 ${unreadable}`,
+    `src/api/leak.ts:1 ${BYPASS}`,
+    `src/api/render.ts:1 ${unreadable}`,
+    `src/lib/door.ts:1 ${unresolved}`,
+  ]);
+
+  const missing = "Coherence could not read coherence.config.json: no such file at the rule's root; set root to the folder that holds it";
+  assert.deepEqual(lint("src/store"), [`door.ts:1 ${missing}`, `secrets.ts:1 ${missing}`], "linted from a folder below the project root, the rule says so instead of reading no spec");
+
+  write("coherence.config.json", "{ not json");
+  const reported = lint();
+  assert.deepEqual(reported.map((line) => line.split(" ")[0]), ["src/__tests__/columns.ts:1", "src/api/leak.ts:1", "src/api/render.ts:1", "src/lib/door.ts:1", "src/store/door.ts:1", "src/store/secrets.ts:1"]);
+  assert.ok(reported.every((line) => line.includes(" Coherence could not read coherence.config.json: coherence.config.json: not valid JSON")), reported.join("\n"));
+
+  write("coherence.config.json", JSON.stringify({ language: "typescript", testDir: "__tests__" }));
+  for (const path of ["src/api/Api.spec.md", "src/lib/Lib.spec.md", "src/lib/door.ts", "src/api/leak.ts"]) remove(path);
+  assert.deepEqual(lint(), []);
+});
+
+test("a module chokepoint is checker-choked when an oxlint configuration over it runs coherence/chokepoint at error in its top-level rules, and reference-choked otherwise", async () => {
+  const grade = async (chokepoint = "seal in door.ts"): Promise<{ grade: string; enforcer: string | undefined; reason: string }> => {
+    await adapter.forget();
+    const result = await checkChokepoint(adapter, { protects: "src/store/secrets.ts", chokepoint, component: "src/store", testFolders: readEnforcementConfig(root).testFolders, root });
+    return { grade: result.grade, enforcer: result.enforcer, reason: result.reason };
+  };
+
+  const credited = await grade();
+  assert.equal(credited.grade, "checker-choked", credited.reason);
+  assert.equal(credited.enforcer, "oxlint (.oxlintrc.json) rule coherence/chokepoint");
+
+  write(".oxlintrc.json", oxlintConfig({ "coherence/chokepoint": "error" }, {}, "@posthog/coherence/lint"));
+  assert.equal((await grade()).grade, "checker-choked", "the package's own specifier names the plugin too");
+
+  write(".oxlintrc.json", oxlintConfig({}));
+  assert.equal((await grade()).grade, "reference-choked", "the plugin loaded without the rule enforces nothing");
+
+  write(".oxlintrc.json", oxlintConfig({ "coherence/chokepoint": "warn" }));
+  assert.equal((await grade()).grade, "reference-choked", "a warning fails no lint");
+
+  write(".oxlintrc.json", oxlintConfig({}, { overrides: [{ files: ["src/api/**"], rules: { "coherence/chokepoint": "error" } }] }));
+  assert.equal((await grade()).grade, "reference-choked", "an override covers part of the workspace, and a chokepoint covers all of it");
+
+  write(".oxlintrc.json", oxlintConfig({}));
+  write(".oxlintrc.strict.json", oxlintConfig({ "coherence/chokepoint": "error" }));
+  assert.equal((await grade()).enforcer, "oxlint (.oxlintrc.strict.json) rule coherence/chokepoint", "a named configuration run with -c counts");
+  remove(".oxlintrc.strict.json");
+
+  write("src/.oxlintrc.json", oxlintConfig({ "coherence/chokepoint": "error" }));
+  assert.equal((await grade()).grade, "reference-choked", "run from src, the rule's root is src, which holds no coherence.config.json");
+  write("src/.oxlintrc.json", oxlintConfig({ "coherence/chokepoint": ["error", { root: ".." }] }));
+  assert.equal((await grade()).enforcer, "oxlint (src/.oxlintrc.json) rule coherence/chokepoint", "with root set to the project root it enforces");
+  remove("src/.oxlintrc.json");
+
+  write("src/api/.oxlintrc.json", oxlintConfig({ "coherence/chokepoint": ["error", { root: "../.." }] }));
+  assert.equal((await grade()).grade, "reference-choked", "a configuration whose folder does not hold the protected module does not lint it");
+
+  write(".oxlintrc.json", oxlintConfig({ "coherence/chokepoint": "error" }));
+  write("src/api/.oxlintrc.json", oxlintConfig({}));
+  assert.equal((await grade()).grade, "reference-choked", "a nested .oxlintrc.json without the rule shadows it for its folder");
+  remove("src/api/.oxlintrc.json");
